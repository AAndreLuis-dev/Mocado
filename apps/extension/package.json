{
  "name": "extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox --mv3",
    "build": "wxt build && wxt build -b firefox --mv3 && node scripts/check-size.mjs",
    "zip": "wxt zip && wxt zip -b firefox --mv3",
    "typecheck": "wxt prepare && tsc --noEmit",
    "test": "vitest run",
    "e2e": "MASSA_E2E=1 wxt build && playwright test",
    "postinstall": "wxt prepare",
    "icons": "tsx scripts/build-icons.ts",
    "lint:firefox": "web-ext lint -s .output/firefox-mv3 --warnings-as-errors=false",
    "demo": "MASSA_E2E=1 wxt build && MASSA_DEMO=1 playwright test e2e/demo.spec.ts && python3 scripts/demo-gif.py .output/demo ../../docs/demo.gif"
  },
  "dependencies": {
    "@massa/core": "workspace:*",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@wxt-dev/i18n": "^0.2.8",
    "@wxt-dev/module-react": "^1.2.2",
    "jsdom": "^30.1.2",
    "tailwindcss": "^4.3.3",
    "web-ext": "^10.7.0",
    "wxt": "^0.21.4",
    "tsx": "^4.23.15"
  }
}
